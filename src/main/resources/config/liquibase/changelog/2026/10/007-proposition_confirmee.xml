<?xml version="1.0" encoding="utf-8" ?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
>
  <changeSet id="proposition_confirmee" author="glm">
    <preConditions onFail="HALT" onError="HALT">
      <sqlCheck expectedResult="0">select count(*) from recu_d_acte</sqlCheck>
    </preConditions>
    <dropColumn tableName="recu_d_acte" columnName="reference" />
    <dropColumn tableName="recu_d_acte" columnName="preuve" />
    <addColumn tableName="recu_d_acte">
      <column name="proposition" type="text">
        <constraints nullable="false" />
      </column>
    </addColumn>
  </changeSet>
</databaseChangeLog>

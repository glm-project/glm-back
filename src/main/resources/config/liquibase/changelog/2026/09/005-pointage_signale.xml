<?xml version="1.0" encoding="utf-8" ?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
>
  <!--
    Les pointages enregistres malgre tout et signales au gestionnaire (lot 8b de la strategie « bornes de fin de
    journee ») : un par evenement, dont il porte l'identifiant, avec ses motifs et, s'il a ete ramene, sa date declaree.
  -->
  <changeSet id="pointage_signale" author="glm">
    <createTable tableName="pointage_signale">
      <column name="id" type="${uuidType}">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="cible_type" type="varchar(32)">
        <constraints nullable="false" />
      </column>
      <column name="cible_id" type="${uuidType}">
        <constraints nullable="false" />
      </column>
      <column name="operateur_id" type="${uuidType}">
        <constraints nullable="false" />
      </column>
      <column name="motifs" type="varchar(200)">
        <constraints nullable="false" />
      </column>
      <column name="date_de_survenue" type="${datetimeType}">
        <constraints nullable="false" />
      </column>
      <column name="date_d_enregistrement" type="${datetimeType}">
        <constraints nullable="false" />
      </column>
      <column name="date_declaree" type="${datetimeType}" />
      <column name="resolution_type" type="varchar(20)" />
      <column name="resolution_auteur" type="varchar(100)" />
      <column name="resolution_date" type="${datetimeType}" />
    </createTable>

    <createIndex indexName="ix_pointage_signale_ouvert" tableName="pointage_signale">
      <column name="resolution_type" />
      <column name="operateur_id" />
      <column name="date_de_survenue" />
    </createIndex>
  </changeSet>
</databaseChangeLog>

<?xml version="1.0" encoding="utf-8" ?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
>
  <changeSet id="sequence_en_conflit" author="glm">
    <comment>
      Les sequences derivees du journal sont projetees par atelier a chaque ecriture pour les lecteurs. Leur identite technique est celle du
      premier pointage de la sequence dans l'ordre du journal. Les ordres des activites et pointages preservent ceux du domaine. Une
      sequence peut ne porter aucune activite.
    </comment>
    <createTable tableName="sequence_en_conflit">
      <column name="id" type="${uuidType}">
        <constraints nullable="false" primaryKey="true" />
      </column>
      <column name="suivi_id" type="${uuidType}">
        <constraints nullable="false" foreignKeyName="fk_sequence_en_conflit_suivi" references="suivi_d_atelier(id)" />
      </column>
      <column name="operateur_id" type="${uuidType}">
        <constraints nullable="false" />
      </column>
      <column name="poste_id" type="${uuidType}" />
    </createTable>
    <createIndex indexName="ix_sequence_en_conflit_suivi" tableName="sequence_en_conflit">
      <column name="suivi_id" />
    </createIndex>
    <createTable tableName="pointage_en_conflit">
      <column name="sequence_id" type="${uuidType}">
        <constraints
          nullable="false"
          primaryKey="true"
          foreignKeyName="fk_pointage_en_conflit_sequence"
          references="sequence_en_conflit(id)"
        />
      </column>
      <column name="evenement_id" type="${uuidType}">
        <constraints
          nullable="false"
          primaryKey="true"
          foreignKeyName="fk_pointage_en_conflit_evenement"
          references="evenement_d_atelier(id)"
        />
      </column>
      <column name="ordre" type="integer">
        <constraints nullable="false" />
      </column>
    </createTable>
    <addUniqueConstraint tableName="pointage_en_conflit" columnNames="sequence_id,ordre" constraintName="uk_pointage_en_conflit_ordre" />
    <addColumn tableName="activite_d_atelier">
      <column name="sequence_id" type="${uuidType}">
        <constraints foreignKeyName="fk_activite_d_atelier_sequence" references="sequence_en_conflit(id)" />
      </column>
      <column name="ordre_dans_sequence" type="integer" />
    </addColumn>
    <createIndex indexName="ix_activite_d_atelier_sequence" tableName="activite_d_atelier">
      <column name="sequence_id" />
    </createIndex>
  </changeSet>
</databaseChangeLog>
